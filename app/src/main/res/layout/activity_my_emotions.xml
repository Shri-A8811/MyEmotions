<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wellness_background">

    <!-- Gradient App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMyEmotions"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_gradient_header"
        app:title="@string/title_my_emotions"
        app:titleTextColor="@color/teal_on_primary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/teal_on_primary" />

    <!-- Horizontal Mood Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_all"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterHappy"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_happy" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterExcited"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_excited" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterSad"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_sad" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterNeutral"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_neutral" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterSurprised"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_surprised" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAngry"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emotion_angry" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Grid / List Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEmotions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_emotions"
            android:textSize="15sp"
            android:textColor="@color/wellness_text_secondary"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"
            android:padding="32dp" />

    </FrameLayout>
</LinearLayout>
