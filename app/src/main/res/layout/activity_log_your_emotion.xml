<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wellness_background">

    <!-- Top Gradient App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLog"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_gradient_header"
        app:title="@string/title_log_emotion"
        app:titleTextColor="@color/teal_on_primary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/teal_on_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Photo Preview Card with Live Camera & AI HUD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/wellness_stroke"
                app:cardBackgroundColor="@color/wellness_surface"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Live Camera Viewfinder -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/cameraPreviewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- Captured or Selected Image -->
                    <ImageView
                        android:id="@+id/ivPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/title_log_emotion" />

                    <!-- Placeholder Before Photo is Taken -->
                    <LinearLayout
                        android:id="@+id/layoutPhotoPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_camera"
                            android:background="@drawable/bg_emotion_badge"
                            android:backgroundTint="#E0F2F1"
                            android:padding="12dp"
                            app:tint="@color/wellness_primary"
                            android:contentDescription="@string/btn_take_photo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Live AI Cam or choose photo"
                            android:textColor="@color/wellness_text_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>

                    <!-- Real-Time Floating Live HUD Pill -->
                    <LinearLayout
                        android:id="@+id/layoutLiveHud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_live_pill"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <View
                            android:id="@+id/viewLivePulse"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_pulse_dot"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tvLiveEmotionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/live_detecting"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Camera Switch (Front/Back) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSwitchCamera"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        app:icon="@drawable/ic_switch_camera"
                        app:iconTint="#FFFFFF"
                        android:backgroundTint="#80000000"
                        android:contentDescription="Flip Camera"
                        android:visibility="gone" />

                    <!-- Live Capture Overlay Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCaptureLive"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:text="@string/btn_capture_live"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#D9004D40"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="21dp"
                        android:visibility="gone" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row: Live AI, System Camera, Gallery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveCamera"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.15"
                    android:layout_marginEnd="4dp"
                    android:text="@string/btn_live_ai"
                    app:icon="@drawable/ic_videocam"
                    app:cornerRadius="12dp"
                    android:backgroundTint="@color/wellness_primary"
                    android:textColor="@color/teal_on_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhoto"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="0.95"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/btn_take_photo"
                    app:icon="@drawable/ic_camera"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#E0F2F1"
                    android:textColor="@color/wellness_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGallery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="0.9"
                    android:layout_marginStart="4dp"
                    android:text="@string/btn_choose_gallery"
                    app:icon="@drawable/ic_gallery"
                    app:cornerRadius="12dp"
                    android:textColor="@color/wellness_primary"
                    app:strokeColor="@color/wellness_primary" />
            </LinearLayout>

            <!-- AI Emotion Recognition Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmotionDetection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/wellness_stroke"
                app:cardBackgroundColor="@color/wellness_surface"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvEmotionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_emotion_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/wellness_primary" />

                    <TextView
                        android:id="@+id/tvEmotionRationale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Take a photo to trigger instant facial emotion recognition"
                        android:textSize="12sp"
                        android:textColor="@color/wellness_text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Emotion Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupEmotions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipHappy"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emotion_happy"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipExcited"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emotion_excited" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipNeutral"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emotion_neutral" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSad"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emotion_sad" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSurprised"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emotion_surprised" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAngry"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/emotion_angry" />

                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Note Input Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNote"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_hint"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:counterEnabled="true"
                app:counterMaxLength="300"
                android:layout_marginBottom="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLength="300" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save Reflection Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveEmotion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_save_emotion"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/wellness_primary" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
